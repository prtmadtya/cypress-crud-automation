{
  "name": "cypress-crud-automation",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "clean:reports": "npx rimraf cypress/results cypress/reports",
    "pretest": "npm run clean:reports",
    "test": "cypress run --reporter mochawesome --reporter-options reportDir=cypress/results,overwrite=false,html=false,json=true",
    "posttest": "npx mochawesome-merge cypress/results/*.json > cypress/results/mochawesome.json && npx marge cypress/results/mochawesome.json -o cypress/reports"
  },
  "devDependencies": {
    "cypress": "^15.21.1",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "keywords": []
}
